datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  password         String
  name             String?
  company          String?
  role             String   @default("CANDIDATE")
  emailVerified    Boolean  @default(false)
  emailVerifiedAt  DateTime?
  emailToken       String?
  recaptchaDone    Boolean  @default(false)
  idUploaded       Boolean  @default(false)
  idDocumentUrl    String?
  idUploadedAt     DateTime?
  idBackUploaded   Boolean  @default(false)
  idBackDocumentUrl String?
  idBackUploadedAt DateTime?
  totpSecret       String?
  totpEnabled      Boolean  @default(false)
  verificationCode String?  @unique
  resetToken       String?  @unique
  resetTokenExpiry DateTime?
  stripePaid           Boolean  @default(false)
  stripeSessionId      String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  signupIp         String?
  termsAcceptedAt  DateTime?
  termsAcceptedIp  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  loginEvents        LoginEvent[]
  subscriptionEvents  SubscriptionEvent[]
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model SubscriptionEvent {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 String   // "canceled" | "payment_failed"
  source               String   // "user" (self-service cancel button) | "stripe_webhook"
  ipAddress            String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())

  @@index([userId])
}
